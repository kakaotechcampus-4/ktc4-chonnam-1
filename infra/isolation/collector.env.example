# /opt/ktc-isolation/collector.env 로 복사해 값을 채운다. compose 와 lockdown.sh 가 함께 읽는다.
# 기본 allowlist 모드의 허용 호스트/IP 는 egress-hosts 에 적는다 (egress-hosts.example 참고).
# Render 대시보드 → Connect → Outbound 의 CIDR (공백 구분)
RENDER_CIDRS="198.51.100.0/24 198.51.100.128/25"

# Default keeps egress-hosts and DNS disabled. Explicit public mode permits HTTPS/443 only.
COLLECTOR_NETWORK_MODE="allowlist"
# Public mode requires ALL fields below. Include Render, collector, and other service
# hostnames (subdomains are also denied) and every service public IPv4 address.
# Shared hosting/CDN IPs are blocked in full; keep this list current before deployment.
COLLECTOR_PROTECTED_HOSTS=""
COLLECTOR_PROTECTED_IPS=""
# One explicit IPv4 DNS resolver; only its UDP/TCP 53 is opened in public mode.
COLLECTOR_DNS_SERVER=""
