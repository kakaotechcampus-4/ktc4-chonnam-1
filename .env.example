# 값은 채우지 말고 이름만 커밋합니다. 실제 값은 .env 에.
LLM_API_KEY=
# 문자 분석(주장 읽기)용. OpenAI 클라이언트로 부르므로 지금 Render 값처럼
# /v1 까지 넣는다. STT_BASE_URL/DIARIZE_BASE_URL과 형식이 다르니 값을
# 복사하지 않는다(.../v1/v1/messages 404).
LLM_BASE_URL=
LLM_MODEL=
# 비우면 LLM_MODEL을 쓴다.
CLAIMS_MODEL=
# whisper STT 엔드포인트 루트. /v1 없이 넣는다(코드가 /v1/audio/transcriptions를 붙인다).
STT_BASE_URL=
# 비우면 whisper-large-v3.
STT_MODEL=
# 화자 분리(Claude) 엔드포인트 루트. /v1 없이 넣는다(코드가 /v1/messages를 붙인다).
DIARIZE_BASE_URL=
# 비우면 claude-sonnet-5-5.
DIARIZE_MODEL=
ISOLATION_API_URL=
ISOLATION_API_TOKEN=
# Optional PEM certificate for the isolation API. System CAs are used when empty.
ISOLATION_API_CA_CERT=
KAKAO_SKILL_SECRET=
# 키 교체 기간에만 설정. 새 값 배포 후 관리자센터 헤더까지 바뀌면 지운다.
KAKAO_SKILL_SECRET_PREVIOUS=
# 카카오 callbackUrl 허용 호스트(쉼표 구분). 비우면 kakao.com 과 하위 도메인만 허용.
# 운영 로그의 [CALLBACK HOST] 로 실제 호스트를 확인한 뒤 정확한 이름으로 좁힌다.
KAKAO_CALLBACK_HOSTS=
# 카카오 음성(통화 녹음) 다운로드를 허용할 CDN 호스트(쉼표 구분). 비우면
# 모든 음성 다운로드를 거부한다. 실기기 확인 결과: talk.kakaocdn.net
KAKAO_MEDIA_HOSTS=
LOG_LEVEL=INFO
