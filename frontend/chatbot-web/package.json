{
  "name": "chatbot-web",
  "private": true,
  "type": "module",
  "description": "챗봇 버튼으로 여는 1회용 웹페이지 (ADR 0006). 빌드한 dist/도 함께 커밋한다.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
